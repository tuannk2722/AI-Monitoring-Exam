    "observations": {
      "student_Using_phone": "Bốn crop 9x9,18x20,36x25,10x9 px; bao vùng nhỏ của tương tác/thiết bị, không đủ người. Không map trực tiếp thành crop person positive.",
      "student_turn_head": "Các mẫu chủ yếu bbox đầu, không phải đầy đủ người/ngữ cảnh bài làm.",
      "student_phone": "Các mẫu crop rất nhỏ (9x8,22x24,8x23,8x12), không đủ person attribution.",
      "student_writing_upright": "Có bbox người/phần thân, kích thước thay đổi; cần liên kết cùng người với bbox đầu/vật thể qua review, không nearest tự động.",
      "classroom_Phone_use": "Các mẫu có cả tay/điện thoại, crop thân/người và người cạnh điện thoại trên bàn; unit không đồng nhất.",
      "exam_Use_phone": "Bốn mẫu có tay/điện thoại hoặc phần thân, không mặc định bbox người đầy đủ."
    },
    "limitation": "Mẫu chọn theo SHA/lineage, không đo tỷ lệ lỗi hoặc đại diện toàn nguồn; chưa gán nhãn target accepted."
  }
